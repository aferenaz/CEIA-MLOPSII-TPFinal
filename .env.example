# Copiar a .env (cp .env.example .env). .env NO se sube al repo.
# Linux/Mac: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=gout-airflow:latest
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

PG_USER=airflow
PG_PASSWORD=airflow
PG_DATABASE=airflow
PG_PORT=5432

MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_PORT=9000
MINIO_PORT_UI=9001
DATA_REPO_BUCKET_NAME=data
MLFLOW_BUCKET_NAME=mlflow

AIRFLOW_PORT=8080
MLFLOW_PORT=5005
API_PORT=8800
GRPC_PORT=50051
KAFKA_PORT_EXTERNAL=29092

MODEL_NAME=gout_demand_model
MODEL_ALIAS=prod
KAFKA_TOPIC_VENTAS=ventas_gout
KAFKA_TOPIC_ALERTAS=alertas_desvio

# Streaming (S4): período a reproducir y umbral de alerta
REPLAY_DESDE=2025-06-01
REPLAY_HASTA=2025-06-30
REPLAY_PAUSA_S=1
UMBRAL_ABS=4
UMBRAL_REL=0.5
